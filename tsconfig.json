{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-slice6.5/types/**/*.ts",
    ".next-recommender-smoke/types/**/*.ts",
    ".next-phase28/types/**/*.ts",
    ".next-wiring/types/**/*.ts",
    ".next-verdict-v31/types/**/*.ts",
    ".next-commit3/types/**/*.ts",
    ".next-eval/types/**/*.ts",
    ".next-mapfix/types/**/*.ts",
    ".next-landscape/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
